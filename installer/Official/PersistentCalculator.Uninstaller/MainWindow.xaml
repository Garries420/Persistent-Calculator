<Window x:Class="PersistentCalculator.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Persistent Calculator"
        Width="720"
        Height="540"
        MinWidth="650"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <StackPanel Orientation="Horizontal">
                <Image Width="58" Height="58" Source="/Assets/PersistentCalculator-96.png" Margin="0,0,18,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="25" FontWeight="SemiBold" Text="Uninstall Persistent Calculator"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Version 1.0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" FontSize="20" FontWeight="SemiBold" Text="Remove Persistent Calculator?"/>
            <TextBlock Grid.Row="1" Margin="0,9,0,16" TextWrapping="Wrap"
                       Text="Application files, shortcuts, and Windows registration will be removed. Your history, currency rates, currency metadata, and other data in Documents\Persistent Calculator will be kept."/>
            <ProgressBar x:Name="Progress" Grid.Row="2" Height="8" Minimum="0" Maximum="100" Value="0"/>
            <ListBox x:Name="ActivityList" Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding ActivityItems}"
                     FontFamily="Consolas" FontSize="12" BorderBrush="{DynamicResource BorderBrush}"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="UninstallButton" Content="Uninstall" Click="UninstallButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
