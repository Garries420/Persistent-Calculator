<Window x:Class="PersistentCalculator.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Persistent Calculator Setup"
        Width="660"
        Height="540"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Persistent Calculator" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Version 1.0" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,25,0,0" Padding="18" Background="{StaticResource PanelBrush}" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Installation and data folder" FontWeight="SemiBold"/>
                <TextBlock x:Name="InstallPathText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Margin="0,12,0,0"
                           Text="History and cached Frankfurter currency data stay in this folder when the app is updated."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Ready to install" FontSize="16" FontWeight="SemiBold"/>
            <ProgressBar x:Name="InstallProgress"
                         Height="8"
                         Margin="0,14,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{StaticResource AccentBrush}"
                         Background="#333640"/>
            <TextBlock x:Name="DetailText"
                       MinHeight="42"
                       Margin="0,12,0,0"
                       Text="The Windows app package will be registered for the current user."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"/>
            <Expander x:Name="ErrorDetailsExpander"
                      Margin="0,10,0,0"
                      Header="Technical details"
                      Visibility="Collapsed">
                <StackPanel Margin="0,8,0,0">
                    <TextBox x:Name="ErrorDetailsTextBox"
                             Height="105"
                             Padding="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="#16181E"
                             Foreground="{StaticResource MutedTextBrush}"
                             BorderBrush="#4B4F5A"
                             BorderThickness="1"/>
                    <Button x:Name="CopyDetailsButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyDetailsButton_Click"
                            Content="Copy details"/>
                </StackPanel>
            </Expander>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CloseButton_Click"
                    Content="Close"/>
            <Button x:Name="InstallButton" Grid.Column="2" Click="InstallButton_Click" Content="Install"/>
        </Grid>
    </Grid>
</Window>
