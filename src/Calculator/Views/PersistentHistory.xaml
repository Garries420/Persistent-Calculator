<UserControl x:Class="CalculatorApp.PersistentHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:CalculatorApp.Common"
             xmlns:utils="using:CalculatorApp.Utils">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button AutomationProperties.Name="Back to calculator"
                    AutomationProperties.AutomationId="HistoryBackButton"
                    Click="BackButton_Click"
                    Content="&#xE72B;"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource SquareIconButtonStyle}"
                    ToolTipService.ToolTip="Back to calculator"/>
            <StackPanel Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="History"/>
            </StackPanel>
        </Grid>

        <ComboBox x:Name="CategoryPicker"
                  Grid.Row="1"
                  Margin="16,4,16,8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.AutomationId="HistoryCategoryPicker"
                  AutomationProperties.Name="Filter history by category"
                  SelectionChanged="CategoryPicker_SelectionChanged"/>

        <Grid Grid.Row="2">
            <TextBlock x:Name="HistoryEmpty"
                       Margin="24,28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No saved calculations in this category yet."
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <ListView x:Name="HistoryListView"
                      Margin="8,0"
                      Padding="0,4,0,16"
                      AutomationProperties.AutomationId="HistoryListView"
                      IsItemClickEnabled="True"
                      ItemClick="HistoryListView_ItemClick"
                      ItemsSource="{x:Bind VisibleEntries, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="common:PersistentHistoryEntry">
                        <Grid MinHeight="92"
                              Margin="4,2,12,10"
                              Padding="10,8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border MaxWidth="150"
                                    Padding="9,2"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="5">
                                <TextBlock FontSize="12"
                                           Text="{x:Bind Mode}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="8,2,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       Text="{x:Bind TimestampLabel}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,9,0,3"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.AutomationId="HistoryItemExpression"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind Expression}"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Right"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="HistoryItemValue"
                                       IsTextSelectionEnabled="True"
                                       Text="{x:Bind Result}"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Button x:Name="ClearHistoryButton"
                Grid.Row="3"
                Margin="16,8,16,14"
                Padding="14,9"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.AutomationId="ClearHistory"
                AutomationProperties.Name="Clear all saved history"
                common:KeyboardShortcutManager.VirtualKeyControlShiftChord="{utils:ResourceVirtualKey Name=ClearHistory/[using:CalculatorApp.Common]KeyboardShortcutManager/VirtualKeyControlShiftChord}"
                Command="{x:Bind ClearHistoryCommand, Mode=OneTime}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="Segoe MDL2 Assets"
                          FontSize="16"
                          Foreground="{ThemeResource AppControlPageTextRedColorBrush}"
                          Glyph="&#xE74D;"/>
                <TextBlock Foreground="{ThemeResource AppControlPageTextRedColorBrush}"
                           FontWeight="SemiBold"
                           Text="Clear all saved history"/>
                <TextBlock x:Name="HistoryFileSizeText"
                           Foreground="{ThemeResource AppControlPageTextRedColorBrush}"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
