<UserControl x:Class="CalculatorApp.UpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="UpdateArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Padding="16,18,16,0" Spacing="14">
                <TextBlock x:Name="UpdateVersionText"
                           AutomationProperties.HeadingLevel="Level1"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <Button HorizontalAlignment="Stretch"
                        AutomationProperties.Name="View changelog"
                        Click="ViewChangelogButton_Click"
                        Content="View changelog"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Padding="16,0,16,18" Spacing="8">
                <CheckBox x:Name="IgnoreUpdateCheckBox"
                          AutomationProperties.Name="Do not notify me again for this update"
                          Click="IgnoreUpdateCheckBox_Click"
                          Content="Do not notify me again"/>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Text="This will only ignore notifying you on startup for this current update, a newer one than this will bring it up again"
                           TextWrapping="Wrap"/>
                <Button x:Name="PrimaryUpdateButton"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Download update"
                        Click="PrimaryUpdateButton_Click"
                        Content="Download"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="UpdateChangelogArea" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ChangelogVersionText"
                       Margin="16,18,16,14"
                       AutomationProperties.HeadingLevel="Level1"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <ScrollViewer Grid.Row="1"
                          Padding="16,0,16,12"
                          VerticalScrollBarVisibility="Auto">
                <Border Padding="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="ReleaseNotesText"
                               TextWrapping="Wrap"/>
                </Border>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Margin="16,0,16,18"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Close changelog"
                    Click="CloseChangelogButton_Click"
                    Content="Close"/>
        </Grid>
    </Grid>
</UserControl>
